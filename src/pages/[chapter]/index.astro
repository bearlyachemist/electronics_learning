import Fet55 from '../../content/power-fet-circuits.mdx';
import Fet56 from '../../content/parallel-mosfets.mdx';
export function getStaticPaths(){return chapters.filter(c=>c.id!=='dividers').map(c=>({params:{chapter:c.id}}));}
const advancedModules = import.meta.glob<{default: any}>('../../content/advanced/*.mdx', {eager:true});
const advancedPages = Object.fromEntries(Object.entries(advancedModules).map(([path,mod])=>[path.split('/').pop()!.replace(/\.mdx$/, ''),mod.default]));
const systemsModules=import.meta.glob<{default:any}>('../../content/systems/*.mdx',{eager:true});
const systemsPages=Object.fromEntries(Object.entries(systemsModules).map(([path,mod])=>[path.split('/').pop()!.replace(/\.mdx$/, ''),mod.default]));
const pages={...systemsPages,...advancedPages,'fet-physics':Fet47,'jfet-bias':Fet48,'jfet-amplifiers':Fet49,'fet-dynamics':Fet50,'fet-switches':Fet51,'mosfet-physics':Fet52,'mosfet-linear':Fet53,'mosfet-power':Fet54,'power-fet-circuits':Fet55,'parallel-mosfets':Fet56,'bjt-logic':Feedback46,'temperature-control':Feedback45,'regulated-supplies':Feedback44,'transistor-feedback':Feedback43,'negative-feedback':Feedback42,'semiconductors':DiodeChapter0,'diodes':DiodeChapter1,'rectifiers':DiodeChapter2,'regulators':DiodeChapter3,'diode-applications':DiodeChapter4,'diode-protection':DiodeChapter5,'protection-circuits':ProtectionCircuits,'current-mirrors':Blk35,'differential-amplifiers':Blk36,'push-pull':Blk37,'darlington':Blk38,'bootstrapping':Blk39,'current-sharing':Blk40,'miller-effect':Blk41,'transistor-physics':Bjt26,'bjt':Bjt27,'emitter-follower':Bjt28,'bjt-biasing':Bjt29,'bjt-small-signal':Bjt30,'current-sources':Bjt31,'common-emitter':Bjt32,'transconductance':Bjt33,'ebers-moll':Bjt34,'phasors':Ac19,'impedance':Ac20,'reactive-power':Ac21,'rc-filters':Ac22,'poles':Ac23,'resonance':Ac24,'ac-thevenin':Ac25,'thevenin':Thevenin,'small-signal':SmallSignal,'power':Power,'capacitors':Chapter0,'rc-circuits':Chapter1,'differentiators':Chapter2,'integrators':Chapter3,'real-capacitors':Chapter4,'inductors':Chapter5,'transformers':Chapter6};
const chapter=Astro.params.chapter as keyof typeof pages;
const Content=pages[chapter];
---
<Book chapter={chapter}><Content/></Book>

