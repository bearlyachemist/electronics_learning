{
  "name": "electronics-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:hosted": "ELECTRONICS_BASE_PATH=/electronics astro build",
    "check:hosted": "node scripts/check-hosted.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check:schematics": "node scripts/check-schematics.mjs",
    "check:advanced": "node scripts/check-advanced.mjs",
    "check:synthesis": "node scripts/check-synthesis.mjs",
    "check:practical": "node scripts/check-practical.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "latest",
    "@astrojs/react": "latest",
    "astro": "latest",
    "katex": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
